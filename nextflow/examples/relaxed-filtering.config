// Example: Run with relaxed filtering while reusing basecalling AND alignment
// Usage: nextflow run main.nf -profile lsf -c examples/relaxed-filtering.config

params {
    // Separate analysis profile
    analysis_profile = "default-relaxed-filter"

    // Use relaxed filtering criteria
    filtering {
        preset = "v2-relaxed"
        bam_filter = "-5 20 -3 20 -s"  // Less stringent adapter requirements
    }

    // Reuse both basecalling AND alignment from default run
    // Only classification and downstream analysis re-run
    reuse_basecalling_from = "default"
    reuse_alignment_from = "default"
}
