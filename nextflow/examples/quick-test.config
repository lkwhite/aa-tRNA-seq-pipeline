// Example: Quick test run with minimal analyses
// Usage: nextflow run main.nf -c examples/quick-test.config

params {
    // Use test data
    samples = "config/samples-test.tsv"
    outdir = "results-test"

    // Disable time-consuming optional analyses
    analyses {
        modkit = false           // Skip modification calling
        remora_signal = false    // Skip signal metrics
        coverage = false         // Skip coverage tracks
        base_error = true        // Keep base error analysis
    }

    // Smaller test reference if available
    // alignment {
    //     reference {
    //         fasta = "resources/ref/test-subset-tRNAs.fa"
    //     }
    // }
}
