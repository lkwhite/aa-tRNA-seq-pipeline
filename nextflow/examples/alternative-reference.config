// Example: Run with alternative reference while reusing basecalling
// Usage: nextflow run main.nf -profile lsf -c examples/alternative-reference.config

params {
    // Change analysis profile to separate outputs
    analysis_profile = "sacCer3-precursor"

    // Use different reference
    alignment {
        reference {
            name = "sacCer3-precursor"
            fasta = "resources/ref/sacCer3-precursor-tRNAs-dual-adapt-v2.fa"
        }
        bwa_opts = "-W 13 -k 6 -T 20 -x ont2d"  // Same alignment parameters
    }

    // Reuse expensive basecalling from default run
    // This saves hours of GPU time!
    reuse_basecalling_from = "default"

    // Everything else uses default from nextflow.config
}
