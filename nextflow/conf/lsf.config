// LSF cluster configuration
// Based on cluster/lsf/config.yaml from Snakemake pipeline

executor {
    name = 'lsf'
    queueSize = 300
    submitRateLimit = '10 sec'
    pollInterval = '30 sec'
}

process {
    executor = 'lsf'
    queue = 'rna'
    clusterOptions = '-P aatrnaseq'

    // Resource scaling with retries
    memory = { 8.GB * task.attempt }
    time = { 4.h * task.attempt }

    // Process-specific resources
    withName: 'MERGE_PODS' {
        cpus = 12
        memory = 8.GB
        time = 2.h
    }

    withName: 'REBASECALL' {
        queue = 'gpu'
        clusterOptions = '-P aatrnaseq -gpu "num=1:j_exclusive=yes"'
        cpus = 8
        memory = { 24.GB * task.attempt }
        time = 12.h
    }

    withName: 'UBAM_TO_FASTQ' {
        cpus = 4
        memory = 8.GB
        time = 1.h
    }

    withName: 'BWA_IDX' {
        cpus = 4
        memory = 8.GB
        time = 1.h
    }

    withName: 'BWA_ALIGN' {
        cpus = 12
        memory = { 24.GB * task.attempt }
        time = 4.h
    }

    withName: 'CLASSIFY_CHARGING' {
        queue = 'gpu'
        clusterOptions = '-P aatrnaseq -gpu "num=1:j_exclusive=yes"'
        cpus = 8
        memory = { 24.GB * task.attempt }
        time = 8.h
    }

    withName: 'TRANSFER_BAM_TAGS' {
        cpus = 4
        memory = 16.GB
        time = 2.h
    }

    withName: 'GET_CCA_TRNA' {
        cpus = 2
        memory = 8.GB
        time = 1.h
    }

    withName: 'GET_CCA_TRNA_CPM' {
        cpus = 2
        memory = 8.GB
        time = 1.h
    }

    withName: 'BASE_CALLING_ERROR' {
        cpus = 4
        memory = 16.GB
        time = 2.h
    }

    withName: 'ALIGN_STATS' {
        cpus = 2
        memory = 8.GB
        time = 1.h
    }

    withName: 'BAM_TO_COVERAGE' {
        cpus = 4
        memory = 16.GB
        time = 2.h
    }

    withName: 'REMORA_SIGNAL_STATS' {
        cpus = 4
        memory = { 24.GB * task.attempt }
        time = 4.h
    }

    withName: 'MODKIT_PILEUP' {
        cpus = 8
        memory = 32.GB
        time = 4.h
    }

    withName: 'MODKIT_EXTRACT_CALLS' {
        cpus = 8
        memory = { 96.GB * task.attempt }
        time = 4.h
    }

    withName: 'MODKIT_EXTRACT_FULL' {
        cpus = 12
        memory = 64.GB
        time = 4.h
    }

    withName: 'SETUP_DORADO' {
        cpus = 2
        memory = 4.GB
        time = 30.min
        queue = 'short'
    }

    withName: 'SETUP_MODKIT' {
        cpus = 2
        memory = 4.GB
        time = 30.min
        queue = 'short'
    }

    withName: 'DOWNLOAD_DORADO_MODEL' {
        cpus = 2
        memory = 4.GB
        time = 1.h
        queue = 'short'
    }
}
