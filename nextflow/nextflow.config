// Main Nextflow configuration for aa-tRNA-seq pipeline
// Migrated from Snakemake pipeline

params {
    // Input/Output
    samples = "config/samples.tsv"
    outdir = "results"

    // Analysis profile for branching workflows
    // Change this to create separate analysis with different parameters
    analysis_profile = "default"

    // Reference and alignment
    alignment {
        reference {
            name = "sacCer3-mature"
            fasta = "resources/ref/sacCer3-mature-tRNAs-dual-adapt-v2.fa"
        }
        bwa_opts = "-W 13 -k 6 -T 20 -x ont2d"
    }

    // Basecalling
    base_calling_model = "resources/models/rna004_130bps_sup@v5.1.0"
    dorado_opts = "--modified-bases pseU m5C inosine_m6A --emit-moves"

    // Remora classification
    remora_cca_classifier = "resources/models/cca_classifier.pt"
    remora_kmer_table = "resources/kmers/9mer_levels_v1.txt"
    remora_opts = ""

    // Filtering
    filtering {
        preset = "v2-strict"
        bam_filter = "-5 24 -3 23 -s"
    }

    // Coverage options
    coverage_opts = "--filterRNAstrand 'reverse' --samFlagExclude 256"

    // Classification threshold
    ml_threshold = 200

    // Tool versions
    dorado_version = "0.9.1"
    dorado_model = "rna004_130bps_sup@v5.1.0"
    modkit_version = "0.4.3"

    // Branching workflow support
    // Set these to reuse expensive computations from another profile
    reuse_basecalling_from = null
    reuse_alignment_from = null

    // Conditional analyses
    analyses {
        modkit = true
        remora_signal = true
        coverage = true
        base_error = true
    }
}

// Process defaults
process {
    // Default resources
    cpus = 1
    memory = 8.GB
    time = 4.h

    // Error handling
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries = 2

    // Conda environment (if using conda profile)
    conda = "$projectDir/workflow/envs/aatrnaseqpipe-env.yml"
}

// Execution profiles
profiles {
    // Local execution profile
    standard {
        process.executor = 'local'
    }

    // LSF cluster profile
    lsf {
        includeConfig 'conf/lsf.config'
    }

    // Conda environment profile
    conda {
        conda.enabled = true
        process.conda = "$projectDir/workflow/envs/aatrnaseqpipe-env.yml"
    }

    // Docker profile (future)
    docker {
        docker.enabled = true
        process.container = 'aatrnaseq:latest'
    }
}

// Report generation
timeline {
    enabled = true
    file = "${params.outdir}/reports/${params.analysis_profile}/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/reports/${params.analysis_profile}/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/reports/${params.analysis_profile}/trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

dag {
    enabled = true
    file = "${params.outdir}/reports/${params.analysis_profile}/dag.html"
    overwrite = true
}

// Manifest
manifest {
    name = 'aa-tRNA-seq-pipeline'
    author = 'Lewis K. White'
    description = 'Nextflow pipeline for processing ONT aa-tRNA-seq data to classify charged vs uncharged tRNAs'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version = '2.0.0'
}

// Capture exit status
workflow.onComplete {
    log.info ""
    log.info "Pipeline completed at: $workflow.complete"
    log.info "Execution status: ${ workflow.success ? 'SUCCESS' : 'FAILED' }"
    log.info "Execution duration: $workflow.duration"
    log.info "Analysis profile: ${params.analysis_profile}"
    log.info ""
    log.info "Reports generated:"
    log.info "  - HTML report: ${params.outdir}/reports/${params.analysis_profile}/report.html"
    log.info "  - Timeline: ${params.outdir}/reports/${params.analysis_profile}/timeline.html"
    log.info "  - Trace: ${params.outdir}/reports/${params.analysis_profile}/trace.txt"
    log.info "  - DAG: ${params.outdir}/reports/${params.analysis_profile}/dag.html"
    log.info ""
}

workflow.onError {
    log.info ""
    log.info "Pipeline execution failed!"
    log.info "Error message: $workflow.errorMessage"
    log.info ""
    log.info "To resume from where you left off, run:"
    log.info "  nextflow run main.nf -resume -profile <your_profile>"
    log.info ""
}
